{
  "name": "ResQRoute Driver Terminal",
  "short_name": "ResQRoute",
  "description": "Highland Corridor Emergency Logistics & Offline Navigation Terminal for Field Drivers.",
  "id": "resqroute-driver-pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0284c7",
  "categories": ["navigation", "logistics", "business", "utilities"],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Driver Cockpit",
      "short_name": "Driver",
      "description": "Open active mission cockpit",
      "url": "/driver/dashboard",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Customer Requisition",
      "short_name": "Requisition",
      "description": "Create new corridor shipment",
      "url": "/customer/dashboard",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
